{
  "name": "video-studio",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=20.17"
  },
  "scripts": {
    "studio": "scripts/studio.sh",
    "video": "scripts/make-video.sh",
    "build": "turbo run build",
    "test": "turbo run test && pnpm test:py",
    "typecheck": "turbo run typecheck",
    "vs": "node apps/cli/bin/vs.mjs",
    "test:py": ".venv/bin/python -m pytest python/tests -q",
    "test:golden": "scripts/golden.sh",
    "test:determinism": "tsx tests/determinism/run.ts"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "esbuild": "^0.25.0",
    "fast-check": "^4.0.0",
    "tsx": "^4.19.0",
    "turbo": "^2.5.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  }
}
